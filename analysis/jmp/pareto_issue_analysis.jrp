		Legend Position( "Bottom" ),
		Show Cum Percent Points( 1 ),
		Label Cum Percent Points( 1 ),
		Per Unit Rates( 1 ),
		N Legend( 1 ),
		SendToReport(
			Dispatch( {"Plots"}, "", TextEditBox,
				{Rotate Text( "Left" ), Set Wrap( 326 ),
				Set Base Font( "Axis Title" )}
			),
			Dispatch( {"Plots"}, "Pareto Report", FrameBox,
				{Frame Size( 481, 326 )}
			),
			Dispatch( {"Plots"}, "", Text Edit Box( 2 ),
				{Rotate Text( "Right" ), Set Wrap( 326 ),
				Set Base Font( "Axis Title" )}
			),
			Dispatch( {"Plots"}, "", Text Edit Box( 3 ),
				{Set Wrap( 481 ), Set Base Font( "Axis Title" )}
			)
		)
	);
